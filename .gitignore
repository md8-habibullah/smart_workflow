# Dependencies
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Build output
frontend/dist/
coverage/

# Environment: one .env at the repo root (keep .env.example tracked)
.env
.env.*
!.env.example
**/.env
**/.env.local

# Vercel CLI
.vercel

# SQLite WebAssembly copied by the backend build (npm run build -w backend)
backend/src/config/sql-wasm.wasm

# SQLite atomic-write temp file and automatic pre-migration backups
backend/data/*.tmp
backend/data/backups/

# User-uploaded files (attachments, profile photos)
backend/uploads/

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

.vercel
.env*
