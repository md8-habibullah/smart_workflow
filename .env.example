# ─────────────────────────────────────────────────────────────────────────────
# Smart Workforce: the ONE configuration file for the whole repository.
# Copy to `.env` (git-ignored) and adjust. The backend reads every key; the
# frontend (Vite) only sees keys that start with VITE_.
# On Vercel, set the same keys under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Server
PORT=5000
# NODE_ENV is not set here: Vite would bundle React's development build. Hosts/scripts set it.

# ---- Database (SQLite file in backend/data/, or :memory: for a throw-away DB)
DB_FILE=smart_workflow.db

# ---- Auth (use a long random value: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=24h
# BCRYPT_ROUNDS=10

# ---- File uploads (task attachments, profile photos); relative to backend/
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=10

# ---- E-mail: SMTP is configured in the app by the super admin (Settings → E-mail settings).
# SETTINGS_SECRET=another-long-random-string   # encrypts the stored SMTP password (default: JWT_SECRET)
# EMAIL_WORKER=off                             # disable the background sender
# PASSWORD_RESET_TTL_MINUTES=30

# ---- Public demo mode (default ON on Vercel, OFF elsewhere)
# DEMO_MODE=true            # in-memory DB, e-mail log-only, demo accounts protected
# DEMO_ALLOW_UPLOADS=false  # allow uploads in demo mode
# TRUST_PROXY=true          # behind a reverse proxy / CDN

# ---- Public URL for links in e-mails (default on Vercel: the production domain)
# APP_URL=https://allocate.habibullah.dev

# ---- CORS (production only, when the frontend is hosted on another origin)
# ALLOWED_ORIGINS=https://your-frontend.example.com

# ---- Frontend (Vite)
# VITE_API_PROXY_TARGET=http://localhost:5000   # dev proxy target for /api
# VITE_API_BASE_URL=https://api.example.com/api # only when the API is on another origin
