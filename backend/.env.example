PORT=5000
NODE_ENV=development

# SQLite Database Configuration
DB_FILE=smart_workflow.db

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_EXPIRES_IN=24h

# File uploads (task attachments, profile photos)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# E-mail: SMTP settings are configured by the super admin in the app (Settings -> E-mail settings)
# and stored in the database; the SMTP password is encrypted with this key (defaults to JWT_SECRET).
# SETTINGS_SECRET=another_long_random_secret
# EMAIL_WORKER=off            # disable the background sender (outbox is still processed on demand)
# PASSWORD_RESET_TTL_MINUTES=30

# CORS Configuration (production only)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.0.2.2:5000
