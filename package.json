{
  "name": "smart-workforce",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "description": "Smart Workforce & Task Allocation System: React + Express + SQLite in one repository, deployable as a single Vercel project",
  "author": {
    "name": "MD. Habibullah Sharif",
    "url": "https://habibullah.dev"
  },
  "homepage": "https://allocate.habibullah.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/md8-habibullah/smart_workflow.git"
  },
  "bugs": {
    "url": "https://github.com/md8-habibullah/smart_workflow/issues"
  },
  "license": "ISC",
  "keywords": [
    "task-allocation",
    "workforce-management",
    "react",
    "express",
    "sqlite",
    "habibullah",
    "task-scheduling",
    "earliest-deadline-first",
    "vercel"
  ],
  "scripts": {
    "setup": "npm install",
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
    "test": "npm test -w backend",
    "lint": "npm run lint -w frontend",
    "check": "npm test && npm run lint && npm run build",
    "db:reset": "npm run db:reset -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:status": "npm run db:status -w backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": ">=20"
  }
}
